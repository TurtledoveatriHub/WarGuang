extends Area2D
class_name CameraLimitZone

## 临时相机范围限制区
## 玩家进入：相机限制框平滑收敛到**本区域矩形**；玩家离开：平滑收敛回进入前的限制框。
## ★ 收敛是**每帧持续驱动**的（不是一次性 tween）：期间如果有别的逻辑改写了限制
##   （门传送的临时解限、房间限制刷新等），只要玩家还在区域内就会被自动纠正回来。
## 区域范围 = 自己的 CollisionShape2D（× 形状节点缩放）。
## ★ 形状缺失 / 类型不支持时直接 push_error —— 不做兜底尺寸猜测。

## 限制框移动速度（世界单位 / 秒）：固定速度推进，从远处进来也能在几百毫秒内到位
@export var blend_speed_units: float = 3200.0
## 离开区域、收敛回原限制后，是否向 RoomManager 再同步一次房间限制
@export var resync_room_limits_on_exit: bool = true

## 超过这个绝对值就当成「无限限制」（PhantomCamera 的默认值 ±1e7）：直接落位，不插值
const UNLIMITED_THRESHOLD: float = 999999.0

## 碰撞形状节点（= 区域范围）
@onready var collision_shape: CollisionShape2D = $CollisionShape2D

## 玩家当前是否在区域内
var _inside: bool = false
## 当前记录的玩家节点
var _player: Node = null
## 进入区域前的限制备份
var _base_limits: Dictionary = {}
## 进入区域前的视口主相机 limit_enabled 备份
var _base_main_limit_enabled: bool = true
## 当前收敛目标限制
var _target_limits: Dictionary = {}
## 离开区域后是否正在收敛回备份值
var _returning: bool = false
## 形状是否可用（不可用时报错并且完全不接管限制）
var _shape_valid: bool = true

## 初始化：连接玩家进出信号，并预校验形状
func _ready() -> void:
	if not body_entered.is_connected(_on_body_entered):
		body_entered.connect(_on_body_entered)
	if not body_exited.is_connected(_on_body_exited):
		body_exited.connect(_on_body_exited)
	_shape_valid = get_zone_world_rect() != Rect2()

## 逐帧驱动限制框收敛
func _process(delta: float) -> void:
	if not _shape_valid:
		return
	if _inside:
		_apply_limits_toward(_target_limits, delta)
		return
	if not _returning:
		return
	if _apply_limits_toward(_target_limits, delta):
		_returning = false
		if resync_room_limits_on_exit and RoomManager != null and RoomManager.has_method("update_camera_limits"):
			# 已在区域内切过房间等情况下，用房间限制做最终校正（同房间时数值相同，不会跳）
			RoomManager.update_camera_limits()

## 区域的世界矩形；形状缺失/类型不支持时 push_error 并返回空矩形
func get_zone_world_rect() -> Rect2:
	if collision_shape == null:
		push_error("CameraLimitZone: 缺少 CollisionShape2D（区域范围），节点=" + str(get_path()))
		return Rect2()
	var shape: Shape2D = collision_shape.shape
	if shape == null:
		push_error("CameraLimitZone: CollisionShape2D 没设 shape（区域范围），节点=" + str(get_path()))
		return Rect2()
	var scale_factor: Vector2 = Vector2(maxf(absf(collision_shape.global_scale.x), 0.001), maxf(absf(collision_shape.global_scale.y), 0.001))
	var size: Vector2 = Vector2.ZERO
	if shape is RectangleShape2D:
		size = (shape as RectangleShape2D).size * scale_factor
	elif shape is CircleShape2D:
		var radius: float = (shape as CircleShape2D).radius * maxf(scale_factor.x, scale_factor.y)
		size = Vector2(radius * 2.0, radius * 2.0)
	else:
		push_error("CameraLimitZone: 区域范围只支持 RectangleShape2D / CircleShape2D，当前=" + shape.get_class() + "，节点=" + str(get_path()))
		return Rect2()
	var center: Vector2 = collision_shape.global_position
	return Rect2(center - size * 0.5, size)

## 玩家进入：备份现有限制 → 目标改为区域矩形
func _on_body_entered(body: Node) -> void:
	if not body.is_in_group("player"):
		return
	if not _shape_valid:
		return
	var zone_rect: Rect2 = get_zone_world_rect()
	if zone_rect == Rect2():
		return
	_player = body
	_backup_limits(body)
	_target_limits = {
		"left": int(zone_rect.position.x),
		"top": int(zone_rect.position.y),
		"right": int(zone_rect.end.x),
		"bottom": int(zone_rect.end.y),
	}
	_inside = true
	_returning = false

## 玩家离开：目标改回备份值
func _on_body_exited(body: Node) -> void:
	if body != _player:
		return
	_inside = false
	_player = null
	_target_limits = _base_limits.duplicate()
	_returning = not _base_limits.is_empty()

## 备份玩家相机与视口主相机的限制
func _backup_limits(player: Node) -> void:
	_base_limits = {}
	var player_camera: Node = _get_player_camera(player)
	if player_camera != null:
		_base_limits = {
			"left": int(player_camera.get("limit_left")),
			"top": int(player_camera.get("limit_top")),
			"right": int(player_camera.get("limit_right")),
			"bottom": int(player_camera.get("limit_bottom")),
		}
	var main_camera: Camera2D = _get_main_camera(player)
	_base_main_limit_enabled = main_camera.limit_enabled if main_camera != null else true

## 把两套限制每帧向目标推进；返回是否已经到达目标
func _apply_limits_toward(target: Dictionary, delta: float) -> bool:
	if target.is_empty():
		return true
	var owner_node: Node = _player if _player != null else _find_player()
	var player_camera: Node = _get_player_camera(owner_node)
	var main_camera: Camera2D = _get_main_camera(owner_node)
	var step: float = maxf(blend_speed_units, 1.0) * delta
	var reached: bool = true
	if player_camera != null:
		reached = _step_limit(player_camera, "limit_left", float(target.get("left", 0)), step) and reached
		reached = _step_limit(player_camera, "limit_top", float(target.get("top", 0)), step) and reached
		reached = _step_limit(player_camera, "limit_right", float(target.get("right", 0)), step) and reached
		reached = _step_limit(player_camera, "limit_bottom", float(target.get("bottom", 0)), step) and reached
	if main_camera != null:
		main_camera.limit_enabled = _base_main_limit_enabled if _returning else true
		reached = _step_limit(main_camera, "limit_left", float(target.get("left", 0)), step) and reached
		reached = _step_limit(main_camera, "limit_top", float(target.get("top", 0)), step) and reached
		reached = _step_limit(main_camera, "limit_right", float(target.get("right", 0)), step) and reached
		reached = _step_limit(main_camera, "limit_bottom", float(target.get("bottom", 0)), step) and reached
	return reached

## 把单个限制值按固定速度向目标推进；返回是否已到位
func _step_limit(target_node: Object, property_name: String, target_value: float, step: float) -> bool:
	var current: float = float(target_node.get(property_name))
	# 无限限制哨兵（±1e7）：直接落位，否则按速度爬会拖几秒
	if absf(current) > UNLIMITED_THRESHOLD:
		target_node.set(property_name, target_value)
		return true
	if is_equal_approx(current, target_value):
		return true
	target_node.set(property_name, move_toward(current, target_value, step))
	return is_equal_approx(float(target_node.get(property_name)), target_value)

## 取玩家身上的 PhantomCamera2D
func _get_player_camera(player: Node) -> Node:
	if player == null:
		return null
	return player.get_node_or_null("PhantomCamera2D")

## 取视口主相机
func _get_main_camera(player: Node) -> Camera2D:
	if player == null or player.get_viewport() == null:
		return null
	return player.get_viewport().get_camera_2d()

## 兜底找一次玩家（只在 _player 已释放时用到）
func _find_player() -> Node:
	return get_tree().get_first_node_in_group("player")
